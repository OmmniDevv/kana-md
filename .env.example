# Salin ke .env lalu isi. Jangan commit .env asli.
BOT_NAME=KANA
BOT_NUMBER=
OWNER_NUMBER=
DEFAULT_LANG=id
TIMEZONE=Asia/Jakarta
STORAGE_DRIVER=local
DATABASE_URL=
LOG_LEVEL=info
# Sapuan temp otomatis: folder kerja kana- di tmp yang lebih tua dari
# TMP_MAX_AGE_MIN menit dibuang tiap TMP_CLEAN_INTERVAL_MIN menit.
AUTO_CLEAN_TMP=true
TMP_MAX_AGE_MIN=60
TMP_CLEAN_INTERVAL_MIN=30
# Auto bio profil (ON + runtime saat connect, OFF saat shutdown rapi).
AUTO_BIO=true
# Template bio, placeholder: {bot} {runtime} {since}. Kosong = default moe.
BIO_ON_TEMPLATE=
BIO_OFF_TEMPLATE=
# Opt-in AI chat (rudder.chat). Kosongkan bila tidak dipakai.
RUDDER_USER_ID=
RUDDER_COOKIE_C0=
RUDDER_COOKIE_C1=
RUDDER_TH_WHO=
# Kanal skor WebSocket untuk game HTML. Kosong = nonaktif.
SCORE_WS_PORT=
# Login web dashboard: URL halaman login (default https://kana.omnicorp.web.id/login).
WEB_LOGIN_URL=
# Harness tes live (scripts/livetest.js). Hanya untuk sesi tes bareng owner.
LIVETEST=
TEST_CHATS=
